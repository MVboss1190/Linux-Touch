{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "linux-touch/distro-v1.json",
  "title": "Linux-Touch Distro Profile v1",
  "description": "A distro profile describes the userspace: init system, how the root filesystem is populated, and what is overlaid on it. It must not describe hardware, kernels, boot chains or runners - those belong to device profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "arch_support",
    "init_system",
    "bootstrap",
    "rootfs",
    "output"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "description": "Stable identifier. Must equal the profile's directory name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["development", "experimental", "supported", "deprecated"]
    },
    "arch_support": {
      "description": "Architectures this userspace can be built for.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "init_system": { "enum": ["busybox"] },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "description": "'busybox' installs the prebuilt BusyBox binary and links applets; 'none' stages nothing.",
          "enum": ["none", "busybox"]
        },
        "binary": {
          "description": "Where the BusyBox binary is installed, relative to the root filesystem.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["method"],
            "properties": { "method": { "const": "busybox" } }
          },
          "then": { "required": ["binary"] }
        }
      ]
    },
    "rootfs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directories"],
      "properties": {
        "directories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
          }
        },
        "applets": {
          "description": "BusyBox applet symlinks, created beside the BusyBox binary.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        }
      }
    },
    "overlay": {
      "description": "Directory copied over the staged tree, relative to the profile directory.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": { "enum": ["cpio.gz"] }
      }
    }
  }
}
